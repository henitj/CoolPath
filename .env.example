# CoolPath environment configuration (copy to .env and adjust)
# All variables are prefixed with COOLPATH_ (see backend/app/core/config.py)

COOLPATH_DATABASE_URL=sqlite:///backend/data/coolpath.db
# COOLPATH_DATABASE_URL=postgresql+psycopg2://coolpath:coolpath@localhost:5432/coolpath
# REDIS_URL=redis://localhost:6379/0

# Force the bundled offline snapshot (no network fetches at all)
# COOLPATH_OFFLINE_MODE=true
COOLPATH_LIVE_REFRESH_ON_STARTUP=true

# Live sources
# COOLPATH_OVERPASS_URL=https://overpass-api.de/api/interpreter
# COOLPATH_PC_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
# COOLPATH_AUSTIN_CANOPY_URL=https://data.austintexas.gov/resource/uj6p-2j9z.geojson?$limit=2000

# Routing / hazard model
# COOLPATH_WALK_SPEED_MPS=1.34
# COOLPATH_HAZARD_BUFFER_M=50
# COOLPATH_HAZARD_HALF_LIFE_H=48
